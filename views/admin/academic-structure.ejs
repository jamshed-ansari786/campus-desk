<%- include("../partials/header", { title }) %>
<div class="admin-shell">
  <%- include("../partials/admin-sidebar", { activePage: "academic-structure" }) %>
  <div class="admin-content">
    <div class="page-heading"><div><p class="eyebrow">ER DIAGRAM · MONGODB</p><h1>Academic structure</h1><p class="muted">University, college, course, semester, subject, student, and teacher records.</p></div><a class="button secondary" href="/admin">← Dashboard</a></div>
    <section class="stats-grid">
