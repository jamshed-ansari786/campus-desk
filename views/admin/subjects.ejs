<%- include("../partials/header", { title }) %>
<div class="admin-shell">
  <%- include("../partials/admin-sidebar", { activePage: "subjects" }) %>
  <div class="admin-content">
    <div class="page-heading"><div><p class="eyebrow">ACADEMIC CATALOGUE</p><h1>Subjects</h1><p class="muted">Maintain the institution's subject master data.</p></div><a class="button secondary" href="/admin">← Dashboard</a></div>
    <section class="two-column">
      <form class="panel" method="POST" action="/admin/subjects"><h2>Add a subject</h2>
        <label>Subject code<input name="code" required placeholder="e.g. BCA107"></label>
        <label>Subject name<input name="name" required placeholder="e.g. JavaScript"></label>
        <label>Credits<input type="number" name="credits" min="0" step="1" required value="5"></label>
        <label>Subject type<select name="subject_type"><option value="CREDIT">Credit</option><option value="NON_CREDIT">Non-credit</option></select></label>
        <button class="button primary full" type="submit">Add subject</button>
      </form>
      <section class="panel"><h2>Subject list <span class="count"><%= subjects.length %></span></h2>
        <div class="table-wrap"><table><thead><tr><th>Code</th><th>Subject</th><th>Credits</th><th>Type</th></tr></thead><tbody>
          <% subjects.forEach(s => { %><tr><td><strong><%= s.code %></strong></td><td><%= s.name %></td><td><%= s.credits %></td><td><span class="status"><%= s.subject_type %></span></td></tr><% }) %>
        </tbody></table></div>
      </section>
    </section>
  </div>
</div>
<%- include("../partials/footer") %>
