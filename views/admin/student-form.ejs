<%- include("../partials/header", { title }) %>
<div class="admin-shell">
  <%- include("../partials/admin-sidebar", { activePage: "students" }) %>
  <div class="admin-content">
    <div class="page-heading">
      <div><p class="eyebrow">STUDENT RECORD</p><h1><%= student ? "Edit student" : "Add student" %></h1><p class="muted">Profile details and academic placement.</p></div>
      <a class="button secondary" href="/admin/students">← Students</a>
    </div>
    <form class="panel" method="POST" action="<%= student ? `/admin/students/${student.student_id}/update` : `/admin/students` %>">
      <div class="form-grid">
        <label>Full name<input name="name" required maxlength="120" value="<%= student ? student.name : '' %>"></label>
        <label>Email<input type="email" name="email" required maxlength="180" value="<%= student ? student.email : '' %>"></label>
        <label>Student ID<input name="student_id" maxlength="80" value="<%= student ? student.custom_student_id : '' %>"></label>
        <label>Phone number<input type="tel" name="phone" maxlength="40" value="<%= student ? student.phone : '' %>"></label>
        <label class="span-two">College and course<select name="college_course_id" required><option value="">Select a college and course</option><% collegeCourses.forEach(item => { %><option value="<%= item._id %>" <%= student && student.college_course_id === String(item._id) ? "selected" : "" %>><%= item.collegeId.name %> — <%= item.courseId.name %></option><% }) %></select></label>
        <label>Department<select name="department_id"><option value="">Not specified</option><% departments.forEach(item => { %><option value="<%= item._id %>" <%= student && student.department_id === String(item._id) ? "selected" : "" %>><%= item.name %></option><% }) %></select></label>
        <label>Semester number<input type="number" name="semester_no" min="1" step="1" value="<%= student ? student.semester_no : '' %>"></label>
        <label>Academic year<input name="academic_year" maxlength="30" placeholder="e.g. 2026–2027" value="<%= student ? student.academic_year : '' %>"></label>
        <label>Enrollment date<input type="date" name="enrollment_date" value="<%= student ? student.enrollment_date : '' %>"></label>
        <label class="span-two">Profile image URL<input type="url" name="profile_image_url" maxlength="500" value="<%= student ? student.profile_image_url : '' %>" placeholder="Optional public image URL"></label>
        <% if (!student) { %>
          <label>Login username<input name="username" required minlength="3" maxlength="40" autocomplete="off"></label>
          <label>Temporary password<input type="password" name="password" required minlength="8" maxlength="72" autocomplete="new-password"><small>Use 8–72 UTF-8 bytes.</small></label>
        <% } %>
      </div>
      <button class="button primary" type="submit"><%= student ? "Save student" : "Create student and login" %></button>
    </form>
  </div>
</div>
<%- include("../partials/footer") %>
