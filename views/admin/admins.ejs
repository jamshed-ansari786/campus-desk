<%- include("../partials/header", { title }) %>
<div class="admin-shell">
  <%- include("../partials/admin-sidebar", { activePage: "admins" }) %>
  <div class="admin-content">
    <div class="page-heading d-flex justify-content-between align-items-center mb-4">
      <div>
        <p class="eyebrow text-uppercase text-primary fw-bold mb-1">ROLES &amp; ACCESS CONTROL</p>
        <h1 class="h2 mb-1">Administrators</h1>
        <p class="text-muted mb-0">Manage system administrators, campus scope, and permissions.</p>
      </div>
      <button class="btn btn-primary rounded-pill d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#newAdminModal">
        <i class="bi bi-person-plus-fill"></i> Add Administrator
      </button>
    </div>

    <div class="card shadow-sm border-0 rounded-3 bg-body">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Admin Name</th>
              <th>Email</th>
              <th>Role</th>
              <th>Assigned Campus</th>
              <th>Status</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (admins && admins.length) { %>
              <% admins.forEach(admin => { %>
                <tr>
                  <td>
                    <div class="d-flex align-items-center gap-2">
                      <div class="rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                        <%= admin.name.charAt(0) %>
                      </div>
                      <div>
                        <strong class="d-block"><%= admin.name %></strong>
                        <small class="text-muted">ID: <%= String(admin._id).slice(-6) %></small>
                      </div>
                    </div>
                  </td>
                  <td><%= admin.email %></td>
                  <td>
                    <span class="badge <%= admin.role === 'SUPER_ADMIN' ? 'bg-danger' : 'bg-primary' %>-subtle text-<%= admin.role === 'SUPER_ADMIN' ? 'danger' : 'primary' %>">
                      <%= admin.role.replace("_", " ") %>
                    </span>
                  </td>
                  <td><%= admin.collegeId ? admin.collegeId.name : "All Campuses (Global)" %></td>
                  <td>
                    <span class="badge <%= admin.status === 'ACTIVE' ? 'bg-success' : 'bg-secondary' %>-subtle text-<%= admin.status === 'ACTIVE' ? 'success' : 'secondary' %>">
                      <%= admin.status %>
                    </span>
                  </td>
                  <td class="text-end">
                    <form method="POST" action="/admin/admins/<%= admin._id %>/status" class="d-inline" onsubmit="return confirm('Toggle status for <%= admin.name %>?');">
                      <button type="submit" class="btn btn-sm <%= admin.status === 'ACTIVE' ? 'btn-outline-danger' : 'btn-outline-success' %> rounded-pill">
                        <%= admin.status === 'ACTIVE' ? 'Deactivate' : 'Activate' %>
                      </button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="6" class="text-center py-4 text-muted">No administrators found.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Add Admin Modal -->
<div class="modal fade" id="newAdminModal" tabindex="-1" aria-labelledby="newAdminModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" action="/admin/admins">
        <div class="modal-header">
          <h5 class="modal-title" id="newAdminModalLabel"><i class="bi bi-shield-plus me-2 text-primary"></i>Create Administrator Account</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Full Name *</label>
            <input type="text" name="name" class="form-control" required placeholder="e.g. Dr. Priya Sharma">
          </div>
          <div class="mb-3">
            <label class="form-label">Email Address *</label>
            <input type="email" name="email" class="form-control" required placeholder="admin@example.com">
          </div>
          <div class="mb-3">
            <label class="form-label">Role *</label>
            <select name="role" class="form-select" required id="adminRoleSelect">
              <option value="COLLEGE_ADMIN">College Admin (Scoped to single campus)</option>
              <option value="SUPER_ADMIN">Super Admin (Full institution access)</option>
            </select>
          </div>
          <div class="mb-3" id="collegeSelectContainer">
            <label class="form-label">Campus Scope</label>
            <select name="collegeId" class="form-select">
              <option value="">-- Select College (Optional for Super Admin) --</option>
              <% if (typeof colleges !== 'undefined' && colleges) { %>
                <% colleges.forEach(c => { %>
                  <option value="<%= c._id %>"><%= c.name %></option>
                <% }) %>
              <% } %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Temporary Password *</label>
            <input type="password" name="password" class="form-control" required minlength="8" placeholder="At least 8 characters">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary rounded-pill">Create Administrator</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include("../partials/footer") %>

