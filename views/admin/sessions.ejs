<%- include("../partials/header", { title }) %>
<div class="admin-shell">
  <%- include("../partials/admin-sidebar", { activePage: "sessions" }) %>
  <div class="admin-content">
    <div class="page-heading d-flex justify-content-between align-items-center mb-4">
      <div>
        <p class="eyebrow text-uppercase text-primary fw-bold mb-1">ACADEMIC CALENDAR</p>
        <h1 class="h2 mb-1">Academic Sessions</h1>
        <p class="text-muted mb-0">Manage institution academic years, terms, and active semester schedules.</p>
      </div>
      <button class="btn btn-primary rounded-pill d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#newSessionModal">
        <i class="bi bi-calendar-plus-fill"></i> New Session
      </button>
    </div>

    <div class="card shadow-sm border-0 rounded-3 bg-body">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Session Name</th>
              <th>Start Date</th>
              <th>End Date</th>
              <th>Current Active</th>
              <th>Status</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (sessions && sessions.length) { %>
              <% sessions.forEach(s => { %>
                <tr>
                  <td><strong class="d-block"><%= s.name %></strong></td>
                  <td><%= new Date(s.startDate).toLocaleDateString() %></td>
                  <td><%= new Date(s.endDate).toLocaleDateString() %></td>
                  <td>
                    <% if (s.isCurrent) { %>
                      <span class="badge bg-success"><i class="bi bi-check-circle-fill me-1"></i> CURRENT</span>
                    <% } else { %>
                      <span class="badge bg-secondary-subtle text-secondary">Inactive</span>
                    <% } %>
                  </td>
                  <td><span class="badge bg-primary-subtle text-primary"><%= s.status %></span></td>
                  <td class="text-end">
                    <% if (!s.isCurrent) { %>
                      <form method="POST" action="/admin/sessions/<%= s._id %>/current" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-success rounded-pill">Set Active</button>
                      </form>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="6" class="text-center py-4 text-muted">No academic sessions defined yet.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Modal -->
<div class="modal fade" id="newSessionModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" action="/admin/sessions">
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-calendar3 me-2 text-primary"></i>Create Academic Session</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Session Name *</label>
            <input type="text" name="name" class="form-control" required placeholder="e.g. 2026-2027 Academic Year">
          </div>
          <div class="mb-3">
            <label class="form-label">Start Date *</label>
            <input type="date" name="startDate" class="form-control" required>
          </div>
          <div class="mb-3">
            <label class="form-label">End Date *</label>
            <input type="date" name="endDate" class="form-control" required>
          </div>
          <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" name="isCurrent" value="true" id="checkCurrent">
            <label class="form-check-label" for="checkCurrent">Set as current active session</label>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary rounded-pill">Save Session</button>
        </div>
      </form>
    </div>
  </div>
</div>
<%- include("../partials/footer") %>

