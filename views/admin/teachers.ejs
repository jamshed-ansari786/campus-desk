<%- include("../partials/header", { title }) %>
<div class="admin-shell">
  <%- include("../partials/admin-sidebar", { activePage: "teachers" }) %>
  <div class="admin-content">
    <div class="page-heading"><div><p class="eyebrow">PEOPLE DIRECTORY</p><h1>Teachers</h1><p class="muted">Search, manage, and safely archive teacher profiles.</p></div><a class="button primary" href="/admin/teachers/new">Add teacher</a></div>
    <form class="panel directory-filters" method="GET" action="/admin/teachers">
      <label>Search by name, teacher ID, or email<input type="search" name="q" value="<%= filters.search %>" placeholder="Search teachers"></label>
      <% if (currentUser.adminRole === "SUPER_ADMIN") { %><label>College<select name="college"><option value="">All colleges</option><% colleges.forEach(item => { %><option value="<%= item._id %>" <%= filters.collegeId === String(item._id) ? "selected" : "" %>><%= item.name %></option><% }) %></select></label><% } %>
      <label>Department<select name="department"><option value="">All departments</option><% departments.forEach(item => { %><option value="<%= item._id %>" <%= filters.departmentId === String(item._id) ? "selected" : "" %>><%= item.name %></option><% }) %></select></label>
      <button class="button primary" type="submit">Search</button>
    </form>
    <p class="muted"><%= pagination.total %> active teacher<%= pagination.total === 1 ? "" : "s" %></p>
    <section class="panel"><div class="table-wrap"><table><thead><tr><th>Teacher</th><th>College</th><th>Department</th><th>Specialization</th><th>Status</th><th>Actions</th></tr></thead><tbody>
    <% teachers.forEach(t => { %><tr><td><strong><a href="/admin/teachers/<%= t.teacher_id %>"><%= t.name %></a></strong><small><%= t.email %><%= t.custom_teacher_id ? ` · ID: ${t.custom_teacher_id}` : "" %></small></td><td><%= t.college_name %></td><td><%= t.department_name %></td><td><%= t.specialization || "—" %></td><td><span class="status"><%= t.status %></span></td><td><div class="decision"><a class="button tiny secondary" href="/admin/teachers/<%= t.teacher_id %>/edit">Edit</a><form method="POST" action="/admin/teachers/<%= t.teacher_id %>/archive" onsubmit="return confirm('Archive this teacher and disable their login?')"><button class="button tiny danger" type="submit">Archive</button></form></div></td></tr><% }) %>
    <% if (!teachers.length) { %><tr><td colspan="6">No active teachers match this search.</td></tr><% } %>
    </tbody></table></div></section>
    <% if (pagination.pages > 1) { %><nav class="pagination" aria-label="Teacher pages">
      <% if (pagination.page > 1) { %><a class="button secondary" href="/admin/teachers?q=<%= encodeURIComponent(filters.search) %>&college=<%= encodeURIComponent(filters.collegeId) %>&department=<%= encodeURIComponent(filters.departmentId) %>&page=<%= pagination.page - 1 %>">Previous</a><% } %>
      <span>Page <%= pagination.page %> of <%= pagination.pages %></span>
      <% if (pagination.page < pagination.pages) { %><a class="button secondary" href="/admin/teachers?q=<%= encodeURIComponent(filters.search) %>&college=<%= encodeURIComponent(filters.collegeId) %>&department=<%= encodeURIComponent(filters.departmentId) %>&page=<%= pagination.page + 1 %>">Next</a><% } %>
    </nav><% } %>
  </div>
</div>
<%- include("../partials/footer") %>
