<%- include("../partials/header", { title }) %>
<div class="admin-shell">
  <%- include("../partials/admin-sidebar", { activePage: "announcements" }) %>
  <div class="admin-content">
    <div class="page-heading d-flex justify-content-between align-items-center mb-4">
      <div>
        <p class="eyebrow text-uppercase text-primary fw-bold mb-1">NOTIFICATIONS &amp; BROADCASTS</p>
        <h1 class="h2 mb-1">Campus Announcements</h1>
        <p class="text-muted mb-0">Broadcast instant messages to all campus users, faculty, or students in real time.</p>
      </div>
      <button class="btn btn-primary rounded-pill d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#newAnnouncementModal">
        <i class="bi bi-broadcast"></i> New Announcement
      </button>
    </div>

    <div class="row g-4">
      <% if (announcements && announcements.length) { %>
        <% announcements.forEach(a => { %>
          <div class="col-12 col-md-6">
            <div class="card shadow-sm border-0 rounded-3 p-3 h-100 bg-body">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="badge <%= a.targetRole === 'ALL' ? 'bg-primary' : a.targetRole === 'STUDENT' ? 'bg-success' : 'bg-info' %>-subtle text-<%= a.targetRole === 'ALL' ? 'primary' : a.targetRole === 'STUDENT' ? 'success' : 'info' %>">
                  Target: <%= a.targetRole %>
                </span>
                <form method="POST" action="/admin/announcements/<%= a._id %>/delete" onsubmit="return confirm('Delete this announcement?');" class="m-0">
                  <button type="submit" class="btn btn-link btn-sm text-danger p-0" title="Delete Announcement"><i class="bi bi-trash"></i></button>
                </form>
              </div>
              <h5 class="fw-bold mb-2"><%= a.title %></h5>
              <p class="text-muted small flex-grow-1"><%= a.content %></p>
              <div class="border-top pt-2 mt-2 d-flex justify-content-between text-secondary small">
                <span>By <%= a.authorName %> (<%= a.authorRole %>)</span>
                <time><%= new Date(a.createdAt).toLocaleString() %></time>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="col-12 text-center py-5 text-muted">
          <i class="bi bi-megaphone fs-1 d-block mb-2"></i>
          <p>No announcements published yet. Click "New Announcement" to broadcast to campus.</p>
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- Modal -->
<div class="modal fade" id="newAnnouncementModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" action="/admin/announcements">
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-megaphone text-primary me-2"></i>Broadcast Campus Announcement</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Title *</label>
            <input type="text" name="title" class="form-control" required placeholder="e.g. Mid-term Exam Schedule Announced">
          </div>
          <div class="mb-3">
            <label class="form-label">Target Audience *</label>
            <select name="targetRole" class="form-select">
              <option value="ALL">Everyone (Students, Teachers, Admins)</option>
              <option value="STUDENT">Students Only</option>
              <option value="TEACHER">Faculty &amp; Teachers Only</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Announcement Content *</label>
            <textarea name="content" class="form-control" rows="4" required placeholder="Type the announcement details here..."></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary rounded-pill">Publish &amp; Broadcast</button>
        </div>
      </form>
    </div>
  </div>
</div>
<%- include("../partials/footer") %>

