<%- include("../partials/header", { title }) %>
<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <p class="text-uppercase text-primary fw-bold mb-1 small">COURSEWORK</p>
      <h1 class="h2 mb-1">Assignments &amp; Projects</h1>
      <p class="text-muted mb-0">Create assignments, set deadlines, and review student submissions.</p>
    </div>
    <button class="btn btn-primary rounded-pill d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#newAssignmentModal">
      <i class="bi bi-plus-circle-fill"></i> New Assignment
    </button>
  </div>

  <div class="row g-4">
    <% if (assignments && assignments.length) { %>
      <% assignments.forEach(a => { %>
        <div class="col-12 col-md-6 col-lg-4">
          <div class="card shadow-sm border-0 rounded-3 p-3 h-100 bg-body d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <span class="badge bg-primary-subtle text-primary"><%= a.subjectName %></span>
              <span class="badge <%= a.status === 'ACTIVE' ? 'bg-success' : 'bg-secondary' %>-subtle text-<%= a.status === 'ACTIVE' ? 'success' : 'secondary' %>">
                <%= a.status %>
              </span>
            </div>
            <h5 class="fw-bold mb-2"><%= a.title %></h5>
            <p class="text-muted small flex-grow-1"><%= a.description || "No instructions provided." %></p>
            
            <div class="border-top pt-2 mt-2">
              <div class="d-flex justify-content-between text-secondary small mb-2">
                <span><i class="bi bi-clock me-1"></i> Due: <%= new Date(a.dueDate).toLocaleDateString() %></span>
                <span>Max: <strong><%= a.maxMarks %> Marks</strong></span>
              </div>
              <div class="d-flex justify-content-between align-items-center">
                <span class="badge bg-info-subtle text-info"><i class="bi bi-inbox-fill me-1"></i> <%= a.submissionCount %> Submissions</span>
                <a href="/teacher/assignments/<%= a._id %>" class="btn btn-sm btn-outline-primary rounded-pill">
                  Review Submissions →
                </a>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="col-12 text-center py-5 text-muted">
        <i class="bi bi-journal-text fs-1 d-block mb-2 text-secondary"></i>
        <h5>No course assignments created yet.</h5>
        <p class="small text-muted">Click "New Assignment" to post coursework for your students.</p>
      </div>
    <% } %>
  </div>
</div>

<!-- Modal -->
<div class="modal fade" id="newAssignmentModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" action="/teacher/assignments">
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-journal-plus text-primary me-2"></i>Create New Course Assignment</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Assignment Title *</label>
            <input type="text" name="title" class="form-control" required placeholder="e.g. Data Structures Project 1">
          </div>
          <div class="mb-3">
            <label class="form-label">Subject *</label>
            <select name="semesterSubjectId" class="form-select" required>
              <% subjects.forEach(s => { %>
                <option value="<%= s.semesterSubjectId %>"><%= s.subjectName %> (<%= s.subjectCode %>)</option>
              <% }) %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Submission Due Date *</label>
            <input type="date" name="dueDate" class="form-control" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Maximum Marks</label>
            <input type="number" name="maxMarks" class="form-control" value="100" min="1">
          </div>
          <div class="mb-3">
            <label class="form-label">Instructions / Description</label>
            <textarea name="description" class="form-control" rows="3" placeholder="Provide problem statement, guidelines, or submission formats..."></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary rounded-pill">Publish Assignment</button>
        </div>
      </form>
    </div>
  </div>
</div>
<%- include("../partials/footer") %>

