<%- include("../partials/header", { title }) %>
<div class="container py-4">
  <div class="mb-4">
    <a href="/teacher/assignments" class="text-decoration-none small text-muted"><i class="bi bi-arrow-left"></i> Back to assignments</a>
    <div class="d-flex justify-content-between align-items-center mt-2">
      <div>
        <h1 class="h2 mb-1"><%= assignment.title %></h1>
        <p class="text-muted mb-0">Due: <strong><%= new Date(assignment.dueDate).toLocaleDateString() %></strong> | Max Marks: <strong><%= assignment.maxMarks %></strong></p>
      </div>
      <span class="badge bg-primary fs-6 px-3 py-2 rounded-pill"><%= submissions.length %> Submissions</span>
    </div>
  </div>

  <div class="card shadow-sm border-0 rounded-3 bg-body mb-4">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Student</th>
            <th>Submitted At</th>
            <th>Submission Content / Link</th>
            <th>Marks</th>
            <th>Feedback</th>
            <th class="text-end">Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (submissions && submissions.length) { %>
            <% submissions.forEach(s => { %>
              <tr>
                <td>
                  <strong class="d-block"><%= s.studentId ? s.studentId.name : "Student" %></strong>
                  <small class="text-muted"><%= s.studentId ? s.studentId.email : "" %></small>
                </td>
                <td><%= new Date(s.submittedAt).toLocaleString() %></td>
                <td>
                  <div style="max-width: 300px; word-break: break-word;">
                    <%= s.submissionText || "" %>
                    <% if (s.fileUrl) { %>
                      <div><a href="<%= s.fileUrl %>" target="_blank" class="small text-primary"><i class="bi bi-link-45deg"></i> <%= s.fileUrl %></a></div>
                    <% } %>
                  </div>
                </td>
                <td>
                  <% if (s.marksObtained !== null) { %>
                    <span class="badge bg-success-subtle text-success fs-6"><%= s.marksObtained %> / <%= assignment.maxMarks %></span>
                  <% } else { %>
                    <span class="badge bg-warning-subtle text-warning">Ungraded</span>
                  <% } %>
                </td>
                <td><small class="text-muted"><%= s.feedback || "No feedback yet" %></small></td>
                <td class="text-end">
                  <button class="btn btn-sm btn-outline-primary rounded-pill" data-bs-toggle="modal" data-bs-target="#gradeModal_<%= s._id %>">
                    <%= s.marksObtained !== null ? 'Update Grade' : 'Grade' %>
                  </button>
                </td>
              </tr>

              <!-- Grade Modal -->
              <div class="modal fade" id="gradeModal_<%= s._id %>" tabindex="-1">
                <div class="modal-dialog">
                  <div class="modal-content">
                    <form method="POST" action="/teacher/assignments/<%= assignment._id %>/grade/<%= s._id %>">
                      <div class="modal-header">
                        <h5 class="modal-title">Grade Submission: <%= s.studentId?.name %></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                      </div>
                      <div class="modal-body">
                        <div class="mb-3">
                          <label class="form-label">Marks Obtained (out of <%= assignment.maxMarks %>) *</label>
                          <input type="number" name="marksObtained" class="form-control" required min="0" max="<%= assignment.maxMarks %>" value="<%= s.marksObtained !== null ? s.marksObtained : '' %>">
                        </div>
                        <div class="mb-3">
                          <label class="form-label">Feedback</label>
                          <textarea name="feedback" class="form-control" rows="3" placeholder="Constructive feedback for the student..."><%= s.feedback || '' %></textarea>
                        </div>
                      </div>
                      <div class="modal-footer">
                        <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary rounded-pill">Save Grade &amp; Notify Student</button>
                      </div>
                    </form>
                  </div>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="6" class="text-center py-4 text-muted">No student submissions received yet for this assignment.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include("../partials/footer") %>

