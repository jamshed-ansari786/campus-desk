<%- include("../partials/header", { title }) %>
<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <p class="text-uppercase text-primary fw-bold mb-1 small">CLASS RECORD</p>
      <h1 class="h2 mb-1">Mark Student Attendance</h1>
      <p class="text-muted mb-0">Record presence and participation for your assigned classes.</p>
    </div>
  </div>

  <!-- Filter & Selection Bar -->
  <div class="card shadow-sm border-0 p-3 mb-4 bg-body rounded-3">
    <form method="GET" action="/teacher/attendance" class="row g-3 align-items-end">
      <div class="col-md-5">
        <label class="form-label small fw-bold">Select Subject</label>
        <select name="subjectId" class="form-select" onchange="this.form.submit()">
          <% subjects.forEach(s => { %>
            <option value="<%= s.semesterSubjectId %>" <%= selectedSubjectId === s.semesterSubjectId ? 'selected' : '' %>>
              <%= s.subjectName %> (<%= s.subjectCode %>) - Sem <%= s.semesterNo %>
            </option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-4">
        <label class="form-label small fw-bold">Attendance Date</label>
        <input type="date" name="date" class="form-control" value="<%= selectedDate %>" onchange="this.form.submit()">
      </div>
      <div class="col-md-3">
        <button type="button" class="btn btn-outline-success rounded-pill w-100" id="markAllPresentBtn">
          <i class="bi bi-check-all me-1"></i> Mark All Present
        </button>
      </div>
    </form>
  </div>

  <!-- Attendance Marking Form -->
  <% if (students && students.length) { %>
    <form method="POST" action="/teacher/attendance">
      <input type="hidden" name="semesterSubjectId" value="<%= selectedSubjectId %>">
      <input type="hidden" name="date" value="<%= selectedDate %>">

      <div class="card shadow-sm border-0 rounded-3 bg-body mb-4">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Student</th>
                <th>Student ID</th>
                <th class="text-center">Status</th>
              </tr>
            </thead>
            <tbody>
              <% students.forEach(student => { %>
                <% const current = attendanceMap[String(student._id)]?.status || 'PRESENT'; %>
                <tr>
                  <td>
                    <strong class="d-block"><%= student.name %></strong>
                    <small class="text-muted"><%= student.email %></small>
                  </td>
                  <td><%= student.studentId || "-" %></td>
                  <td class="text-center">
                    <div class="btn-group" role="group">
                      <input type="radio" class="btn-check att-radio-present" name="attendance[<%= student._id %>]" id="pres_<%= student._id %>" value="PRESENT" <%= current === 'PRESENT' ? 'checked' : '' %>>
                      <label class="btn btn-sm btn-outline-success px-3" for="pres_<%= student._id %>">Present</label>

                      <input type="radio" class="btn-check" name="attendance[<%= student._id %>]" id="late_<%= student._id %>" value="LATE" <%= current === 'LATE' ? 'checked' : '' %>>
                      <label class="btn btn-sm btn-outline-warning px-3" for="late_<%= student._id %>">Late</label>

                      <input type="radio" class="btn-check" name="attendance[<%= student._id %>]" id="abs_<%= student._id %>" value="ABSENT" <%= current === 'ABSENT' ? 'checked' : '' %>>
                      <label class="btn btn-sm btn-outline-danger px-3" for="abs_<%= student._id %>">Absent</label>

                      <input type="radio" class="btn-check" name="attendance[<%= student._id %>]" id="exc_<%= student._id %>" value="EXCUSED" <%= current === 'EXCUSED' ? 'checked' : '' %>>
                      <label class="btn btn-sm btn-outline-info px-3" for="exc_<%= student._id %>">Excused</label>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <div class="card-footer bg-body py-3 d-flex justify-content-between align-items-center">
          <span class="text-muted small">Total students in roster: <%= students.length %></span>
          <button type="submit" class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-save me-1"></i> Save Attendance
          </button>
        </div>
      </div>
    </form>
  <% } else { %>
    <div class="card shadow-sm border-0 p-5 text-center text-muted bg-body rounded-3">
      <i class="bi bi-people fs-1 text-secondary mb-2"></i>
      <h5>No students enrolled in this subject.</h5>
      <p class="small text-muted mb-0">Students can enroll from their dashboard or campus administrators can assign them.</p>
    </div>
  <% } %>
</div>

<script>
  document.getElementById("markAllPresentBtn")?.addEventListener("click", () => {
    document.querySelectorAll(".att-radio-present").forEach(r => r.checked = true);
  });
</script>
<%- include("../partials/footer") %>

