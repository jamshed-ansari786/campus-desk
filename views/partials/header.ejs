<!doctype html>
<html lang="en" data-theme="light" data-bs-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | CampusDesk</title>
  
  <!-- Immediate Theme Initialization to prevent flash of unstyled content -->
  <script>
    (function () {
      try {
        const savedTheme = localStorage.getItem("theme") || "light";
        document.documentElement.setAttribute("data-theme", savedTheme);
        document.documentElement.setAttribute("data-bs-theme", savedTheme);
      } catch (e) {}
    })();
  </script>
  
  <!-- Bootstrap 5 CSS & Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  
  <!-- Chart.js for Admin & Analytics -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <!-- Socket.IO Client & Shared Connection Manager -->
  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/socket-client.js"></script>

  <!-- Custom Styles -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body data-authenticated="<%= Boolean(currentUser) %>" class="<%= currentUser && currentUser.role === 'ADMIN' ? 'admin-app' : 'portal-app' %><%= typeof isHome !== 'undefined' && isHome ? ' home-page' : '' %><%= typeof isAuthPage !== 'undefined' && isAuthPage ? ' auth-page' : '' %><%= typeof adminLogin !== 'undefined' && adminLogin ? ' admin-login-page' : '' %>">
<header class="topbar sticky-top shadow-sm">
  <div class="d-flex align-items-center gap-2">
    <a class="brand text-decoration-none" href="/" aria-label="CampusDesk home">
      <span class="brand-symbol" aria-hidden="true">C</span>
      <span class="brand-name">Campus<span>Desk</span></span>
    </a>
  </div>

  <nav class="<%= typeof isHome !== 'undefined' && isHome ? 'home-nav' : '' %> d-flex align-items-center gap-3 ms-auto" aria-label="Main navigation">
    <% if (typeof adminLogin !== 'undefined' && adminLogin) { %>
      <a href="/login" class="text-decoration-none text-muted">Student &amp; teacher portal <span aria-hidden="true">→</span></a>
    <% } else if (typeof isHome !== 'undefined' && isHome) { %>
      <a href="/" class="nav-link-custom">Home</a>
      <a href="/colleges" class="nav-link-custom">Universities</a>
      <a href="#learning-paths" class="nav-link-custom">Learning paths</a>
      <a href="#assistant-intro" class="nav-link-custom">Career guidance</a>
      <a href="#contact" class="nav-link-custom">Contact us</a>
    <% } else { %>
      <a href="/colleges" class="nav-link-custom">Universities</a>
    <% } %>

    <!-- Dark/Light Mode Switcher -->
    <button type="button" class="btn btn-sm btn-link text-decoration-none p-1" id="themeToggleBtn" title="Toggle dark/light mode" aria-label="Toggle dark/light theme">
      <i class="bi bi-moon-stars-fill text-secondary fs-5" id="themeIcon"></i>
    </button>

    <% if (currentUser) { %>
      <!-- Notification Dropdown -->
      <div class="dropdown position-relative">
        <button class="btn btn-sm btn-light border rounded-circle position-relative p-2" type="button" id="notifDropdownBtn" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications">
          <i class="bi bi-bell-fill text-secondary"></i>
          <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="notifBadge" style="display: none; font-size: 0.65rem;">0</span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow border-0 p-0" style="width: 320px; max-height: 400px; overflow-y: auto;" aria-labelledby="notifDropdownBtn">
          <li class="p-2 border-bottom d-flex justify-content-between align-items-center bg-light">
            <strong class="small">Notifications</strong>
            <button class="btn btn-link btn-sm p-0 text-decoration-none small" id="markAllReadBtn">Mark all as read</button>
          </li>
          <div id="notifListContainer">
            <li class="p-3 text-center text-muted small">Loading notifications...</li>
          </div>
        </ul>
      </div>

      <!-- Real-time Messages Link -->
      <a href="/chat" class="btn btn-sm btn-outline-primary rounded-pill d-flex align-items-center gap-1" title="Real-time Chat">
        <i class="bi bi-chat-dots-fill"></i>
        <span>Chat</span>
      </a>

      <!-- Portal Dashboard Links -->
      <% if (currentUser.role === "ADMIN") { %>
        <a href="/admin" class="btn btn-sm btn-primary rounded-pill">Admin Dashboard</a>
      <% } else if (currentUser.role === "STUDENT") { %>
        <a href="/student" class="btn btn-sm btn-primary rounded-pill">Student Portal</a>
      <% } else if (currentUser.role === "TEACHER") { %>
        <a href="/teacher" class="btn btn-sm btn-primary rounded-pill">Teacher Portal</a>
      <% } %>

      <!-- User Menu -->
      <div class="dropdown">
        <button class="btn btn-sm btn-outline-secondary dropdown-toggle rounded-pill d-flex align-items-center gap-1" type="button" data-bs-toggle="dropdown">
          <i class="bi bi-person-circle"></i>
          <span><%= currentUser.name %></span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow border-0">
          <li><h6 class="dropdown-header"><%= currentUser.role %> (<%= currentUser.email %>)</h6></li>
          <% if (currentUser.role === "ADMIN") { %>
            <li><a class="dropdown-item" href="/admin/admins"><i class="bi bi-shield-lock me-2"></i>Admins</a></li>
            <li><a class="dropdown-item" href="/admin/reports"><i class="bi bi-file-earmark-bar-graph me-2"></i>Reports</a></li>
            <li><a class="dropdown-item" href="/admin/fees"><i class="bi bi-cash-stack me-2"></i>Fees</a></li>
          <% } else if (currentUser.role === "TEACHER") { %>
            <li><a class="dropdown-item" href="/teacher/attendance"><i class="bi bi-calendar-check me-2"></i>Attendance</a></li>
            <li><a class="dropdown-item" href="/teacher/assignments"><i class="bi bi-journal-text me-2"></i>Assignments</a></li>
            <li><a class="dropdown-item" href="/teacher/grades"><i class="bi bi-award me-2"></i>Grades</a></li>
          <% } else if (currentUser.role === "STUDENT") { %>
            <li><a class="dropdown-item" href="/student/attendance"><i class="bi bi-calendar-check me-2"></i>My Attendance</a></li>
            <li><a class="dropdown-item" href="/student/assignments"><i class="bi bi-journal-text me-2"></i>My Assignments</a></li>
            <li><a class="dropdown-item" href="/student/grades"><i class="bi bi-award me-2"></i>My Grades</a></li>
            <li><a class="dropdown-item" href="/student/fees"><i class="bi bi-cash-stack me-2"></i>My Fees</a></li>
          <% } %>
          <li><hr class="dropdown-divider"></li>
          <li>
            <form method="POST" action="/logout" class="m-0">
              <button class="dropdown-item text-danger d-flex align-items-center gap-2" type="submit">
                <i class="bi bi-box-arrow-right"></i> Logout
              </button>
            </form>
          </li>
        </ul>
      </div>
    <% } else { %>
      <% if (!(typeof adminLogin !== 'undefined' && adminLogin)) { %>
        <a href="/login" class="nav-link-custom">Login</a>
        <a class="btn btn-sm btn-primary rounded-pill px-3" href="/signup">Sign up</a>
      <% } %>
    <% } %>
  </nav>
</header>
<main class="page">
  <% if (flash) { %>
    <div class="alert alert-<%= flash.type === 'success' ? 'success' : 'danger' %> alert-dismissible fade show m-3" role="alert">
      <%= flash.message %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>
