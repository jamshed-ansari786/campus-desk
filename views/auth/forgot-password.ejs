<%- include("../partials/header", { title, isAuthPage: true }) %>
<section class="admin-login-shell auth-page-shell">
  <div class="admin-login-story">
    <p class="admin-login-kicker"><span></span> ACCOUNT RECOVERY</p>
    <h1>Get back to<br><em>your campus.</em></h1>
    <p class="admin-login-intro">Verify the email address on your account, then choose a new password to get back into CampusDesk.</p>
    <div class="admin-login-art" aria-hidden="true">
      <div class="admin-art-sidebar"><span></span><span></span><span></span><span></span></div>
      <div class="admin-art-content">
        <div class="admin-art-top"><span></span><span></span></div>
        <div class="admin-art-highlight"><span></span><span></span><span></span></div>
        <div class="admin-art-columns"><span></span><span></span><span></span></div>
        <div class="admin-art-lines"><span></span><span></span><span></span></div>
      </div>
      <span class="admin-art-orbit"></span>
    </div>
    <p class="admin-login-caption"><span aria-hidden="true">✦</span> Your account stays protected</p>
  </div>

  <form
    class="panel admin-auth-form auth-page-form password-reset-form"
    method="POST"
    action="<%= pendingOtp ? '/reset-password' : '/forgot-password' %>"
    novalidate
  >
    <div class="admin-form-mark" aria-hidden="true">C</div>
    <p class="eyebrow">PASSWORD HELP</p>
    <h2><%= pendingOtp ? "Choose a new password" : "Forgot your password?" %></h2>
    <p class="muted">
      <%= pendingOtp
        ? `Enter the verification code and a new password. The code expires in ${otpExpiresInMinutes} minutes.`
        : "Enter your account email and we’ll help you reset your password." %>
    </p>

    <% if (formError) { %>
      <div class="form-error-summary" role="alert"><%= formError %></div>
    <% } %>
    <% if (formSuccess) { %>
      <div class="password-reset-notice" role="status"><%= formSuccess %></div>
    <% } %>
    <% if (generatedOtp) { %>
      <div class="otp-demo-notice" role="status">
        <strong>Development code: <%= generatedOtp %></strong>
        <span>For local development only. No email/SMS delivery provider is configured.</span>
      </div>
    <% } %>

    <% if (!pendingOtp) { %>
      <label>Email address
        <input
          name="email"
          type="email"
          value="<%= formData.email || '' %>"
          autocomplete="email"
          maxlength="180"
          required
          placeholder="you@campus.edu"
          aria-describedby="error-email"
        >
        <small id="error-email" class="field-error"><%= fieldErrors.email || "" %></small>
      </label>
      <button class="button primary full" type="submit">Continue <span aria-hidden="true">→</span></button>
    <% } else { %>
      <input type="hidden" name="email" value="<%= formData.email || '' %>">
      <label>Verification code
        <input
          name="otp"
          inputmode="numeric"
          autocomplete="one-time-code"
          maxlength="6"
          pattern="[0-9]{6}"
          required
          placeholder="Enter 6-digit code"
          aria-describedby="error-otp"
        >
        <small id="error-otp" class="field-error"><%= fieldErrors.otp || "" %></small>
      </label>
      <label>New password
        <input
          name="password"
          type="password"
          autocomplete="new-password"
          minlength="8"
          maxlength="72"
          required
          placeholder="At least 8 characters"
          aria-describedby="error-password"
        >
        <small id="error-password" class="field-error"><%= fieldErrors.password || "" %></small>
      </label>
      <label>Confirm new password
        <input
          name="confirmPassword"
          type="password"
          autocomplete="new-password"
          minlength="8"
          maxlength="72"
          required
          placeholder="Enter your new password again"
          aria-describedby="error-confirmPassword"
        >
        <small id="error-confirmPassword" class="field-error"><%= fieldErrors.confirmPassword || "" %></small>
      </label>
      <button class="button primary full" type="submit">Reset password <span aria-hidden="true">→</span></button>
    <% } %>
    <p class="muted center"><a href="/login">Back to login</a> · <a href="/admin/login">Admin login</a></p>
  </form>
</section>
<%- include("../partials/footer") %>
